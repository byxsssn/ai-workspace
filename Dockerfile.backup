FROM ghcr.io/astral-sh/uv:0.12.5 AS uv
FROM postgres:18

COPY --from=uv /uv /usr/local/bin/uv
ENV UV_PYTHON_INSTALL_DIR=/opt/python UV_LINK_MODE=copy PYTHONUNBUFFERED=1
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv python install 3.14 && uv sync --locked --only-group backup --no-install-project --python 3.14 \
    && useradd --uid 10002 --create-home --shell /usr/sbin/nologin backupjob
COPY scripts/backup_database.py ./scripts/backup_database.py
USER 10002:10002
ENTRYPOINT []
CMD ["/app/.venv/bin/python", "/app/scripts/backup_database.py"]
