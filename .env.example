AI_WORKSPACE_APP_NAME="AI Workspace"
AI_WORKSPACE_APP_VERSION=0.1.0
AI_WORKSPACE_ENVIRONMENT=development
AI_WORKSPACE_DEBUG=false
# Replace this placeholder with a random secret of at least 32 characters.
AI_WORKSPACE_JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-chars
AI_WORKSPACE_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# Generate a separate key with Fernet.generate_key(); never reuse the JWT secret.
AI_WORKSPACE_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
AI_WORKSPACE_DATABASE_URL=postgresql+asyncpg://ai_workspace:ai_workspace@localhost:5432/ai_workspace
